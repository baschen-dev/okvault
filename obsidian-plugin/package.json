{
  "name": "okvault-obsidian",
  "version": "0.5.0",
  "private": true,
  "description": "Obsidian plugin for okvault: FAQ search and a map of the vault's OKF bundle.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings test/run.ts",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.6.0",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "yaml": "2.9.1"
  }
}
